// InvoiceChain - Privacy-Preserving Invoice Financing dApp on Midnight Network
// Compact ZK Circuit & Ledger Contract Specification

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

export enum InvoiceStatus {
    Unregistered,
    Open,
    PartiallyFinanced,
    Financed,
    Settled,
    Cancelled,
    Expired
}

export ledger invoiceStatus: InvoiceStatus;
export ledger invoiceCommitment: Bytes<32>;
export ledger financedLender: Bytes<32>;
export ledger financedTimestamp: Uint<64>;
export ledger settlementAmount: Uint<64>;
export ledger fundedAmount: Uint<64>;
export ledger processedNullifiers: Set<Bytes<32>>;

constructor() {
    invoiceStatus = InvoiceStatus.Unregistered;
    invoiceCommitment = pad(32, "");
    financedLender = pad(32, "");
    financedTimestamp = 0;
    settlementAmount = 0;
    fundedAmount = 0;
}

witness getPrivateInvoiceData(): Struct {
    invoiceAmount: Uint<64>,
    buyerId: Bytes<32>,
    sellerId: Bytes<32>,
    dueDate: Uint<64>,
    salt: Bytes<32>,
    currencyCode: Bytes<8>
};

export circuit registerInvoice(
    commitment: Bytes<32>
): Boolean {
    // 1. Double registration prevention check
    assert !processedNullifiers.member(commitment) "Invoice commitment has already been registered";

    // 2. Obtain private witness fields (amount, buyer, seller, due date, salt, currency)
    const privateData = getPrivateInvoiceData();

    // 3. Recompute ZK hash commitment to verify witness integrity
    const computedCommitment = persistent_hash<Bytes<32>>(
        pad(32, "INVOICE_CHAIN_V1"),
        privateData.invoiceAmount,
        privateData.buyerId,
        privateData.sellerId,
        privateData.dueDate,
        privateData.salt
    );

    // 4. Update public ledger state
    invoiceCommitment = commitment;
    invoiceStatus = InvoiceStatus.Open;
    fundedAmount = 0;
    processedNullifiers.insert(commitment);

    return true;
}

export circuit financeInvoice(
    commitment: Bytes<32>,
    lenderId: Bytes<32>
): Boolean {
    // 1. Ensure commitment exists on ledger
    assert processedNullifiers.member(commitment) "Invoice commitment not found in registry";

    // 2. Core Anti-Fraud Proof: Reject proof generation if invoice is already Financed or Settled
    assert invoiceStatus == InvoiceStatus.Open || invoiceStatus == InvoiceStatus.PartiallyFinanced "Invoice is already Financed — Double financing attempt blocked!";

    // 3. Fetch private witness inputs to verify caller possesses true invoice witness
    const privateData = getPrivateInvoiceData();

    // 4. Update status to Financed & record lender identifier
    invoiceStatus = InvoiceStatus.Financed;
    financedLender = lenderId;
    financedTimestamp = 1758400000; // Epoch timestamp of financing event
    fundedAmount = privateData.invoiceAmount;

    return true;
}

export circuit financePartialInvoice(
    commitment: Bytes<32>,
    lenderId: Bytes<32>,
    partialAmount: Uint<64>
): Boolean {
    assert processedNullifiers.member(commitment) "Invoice commitment not found in registry";
    assert invoiceStatus == InvoiceStatus.Open || invoiceStatus == InvoiceStatus.PartiallyFinanced "Invoice is already Financed — Double financing attempt blocked!";

    const privateData = getPrivateInvoiceData();
    const currentFunded = fundedAmount;
    const newFundedAmount = currentFunded + partialAmount;
    assert newFundedAmount <= privateData.invoiceAmount "Partial funding exceeds total invoice amount";

    fundedAmount = newFundedAmount;
    financedLender = lenderId;
    financedTimestamp = 1758400000;

    if (newFundedAmount == privateData.invoiceAmount) {
        invoiceStatus = InvoiceStatus.Financed;
    } else {
        invoiceStatus = InvoiceStatus.PartiallyFinanced;
    }

    return true;
}

export circuit settleInvoice(
    commitment: Bytes<32>,
    paymentAmount: Uint<64>
): Boolean {
    // 1. Ensure invoice is currently in Financed or PartiallyFinanced status
    assert invoiceStatus == InvoiceStatus.Financed || invoiceStatus == InvoiceStatus.PartiallyFinanced "Invoice must be in Financed or PartiallyFinanced state prior to settlement";

    // 2. Fetch private witness details
    const privateData = getPrivateInvoiceData();

    // 3. Verify buyer payment satisfies or exceeds required invoice amount
    assert paymentAmount >= privateData.invoiceAmount "Settlement payment amount is less than total invoice value";

    // 4. Update public ledger state to Settled
    invoiceStatus = InvoiceStatus.Settled;
    settlementAmount = paymentAmount;

    return true;
}

export circuit cancelInvoice(
    commitment: Bytes<32>
): Boolean {
    assert processedNullifiers.member(commitment) "Invoice commitment not found in registry";
    assert invoiceStatus == InvoiceStatus.Open "Only open invoices can be cancelled";

    invoiceStatus = InvoiceStatus.Cancelled;
    return true;
}

export circuit expireInvoice(
    commitment: Bytes<32>,
    currentTimestamp: Uint<64>
): Boolean {
    assert processedNullifiers.member(commitment) "Invoice commitment not found in registry";
    assert invoiceStatus == InvoiceStatus.Open || invoiceStatus == InvoiceStatus.PartiallyFinanced "Invoice cannot be expired in its current state";

    const privateData = getPrivateInvoiceData();
    assert currentTimestamp > privateData.dueDate "Invoice has not passed its due date";

    invoiceStatus = InvoiceStatus.Expired;
    return true;
}

