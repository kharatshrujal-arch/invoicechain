# =================================================================
# INVOICECHAIN - MIDNIGHT PREPROD ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# Public / Frontend Environment Variables (VITE_ prefixed)
# -----------------------------------------------------------------

# Midnight Network Name (preprod | testnet | mainnet)
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Preprod RPC Node Endpoint
VITE_MIDNIGHT_RPC_URL=https://rpc.preprod.midnight.network

# Midnight Preprod Indexer GraphQL Endpoint
VITE_MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v1/graphql

# Midnight Local Proof Server URL (Default: http://localhost:6300)
VITE_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Deployed Contract Address (32 bytes / 64 hex characters with 0x prefix)
# Example: 0x02008f7a9c1e2b3d4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e
VITE_CONTRACT_ADDRESS=

# -----------------------------------------------------------------
# Private / Deployment Environment Variables (NEVER commit secrets!)
# -----------------------------------------------------------------

# Midnight Deployment Seed / Private Key (Obtained from Midnight Preprod Faucet)
# MIDNIGHT_DEPLOYMENT_SEED="your_midnight_preprod_wallet_seed_or_private_key"
